# Local environment example for LexiScan Pro
# Add your actual keys to .env.local (do NOT commit credentials)

VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional cloud sync (replace if you want Supabase-based cloud flows)
VITE_SUPABASE_URL=https://your-supabase-url
VITE_SUPABASE_KEY=your_supabase_key_here
